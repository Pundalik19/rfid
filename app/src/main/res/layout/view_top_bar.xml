<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:background="#1E88E5"
    android:paddingHorizontal="12dp"
    android:gravity="center_vertical">

    <!-- LEFT: Network + Username -->
    <LinearLayout
        android:id="@+id/leftSection"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_alignParentStart="true"
        android:gravity="center_vertical">

        <!-- Network -->
        <LinearLayout
            android:id="@+id/networkSection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:id="@+id/networkDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_dot_green"
                android:layout_marginEnd="4dp"/>

            <TextView
                android:id="@+id/txtNetwork"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Online"
                android:textColor="#FFF"
                android:textSize="12sp"/>
        </LinearLayout>

        <!-- Space -->
        <View
            android:layout_width="8dp"
            android:layout_height="1dp"/>

        <!-- Username -->
        <LinearLayout
            android:id="@+id/userSection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_user"
                app:tint="#FFF"/>

            <TextView
                android:id="@+id/txtUsername"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="User"
                android:textColor="#FFF"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginStart="6dp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- CENTER: Sync -->
    <LinearLayout
        android:id="@+id/syncSection"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="horizontal"
        android:gravity="center">

        <ImageView
            android:id="@+id/imgSync"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_sync"
            app:tint="#FFF"/>

        <TextView
            android:id="@+id/txtSync"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Syncing 0%"
            android:textColor="#FFF"
            android:textSize="13sp"
            android:layout_marginStart="6dp"/>
    </LinearLayout>

    <!-- RIGHT: Logout -->
    <ImageView
        android:id="@+id/btnLogout"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:src="@drawable/ic_logout"
        app:tint="#FFF"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"/>
</RelativeLayout>